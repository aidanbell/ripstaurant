# Copy to .env for local dev. .env is git-ignored. Never put real credentials here.

# Local Postgres from db/compose.yaml (bun run db:up). Dev-only password, localhost only.
DATABASE_URL=postgres://ripstaurant:ripstaurant@localhost:5432/ripstaurant

# Raw-file archive (R2), used only by `bun run snapshot --upload`. Local runs write to
# data/raw/, so local dev doesn't need these. Production values live in GitHub secrets.
# R2 endpoint: https://<account-id>.r2.cloudflarestorage.com
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
