{
  "name": "ripstaurant",
  "private": true,
  "type": "module",
  "workspaces": [
    "contract",
    "db",
    "pipeline",
    "web",
    "research/*"
  ],
  "scripts": {
    "sample": "bun contract/scripts/build-sample.ts",
    "sample:synthetic": "bun contract/scripts/build-sample.ts --synthetic 10000",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start:web": "bun run --filter @ripstaurant/web dev",
    "db:up": "docker compose -f db/compose.yaml up -d --wait",
    "db:down": "docker compose -f db/compose.yaml down",
    "db:reset": "docker compose -f db/compose.yaml down -v && bun run db:up && bun run db:migrate",
    "db:migrate": "bun db/src/migrate.ts",
    "snapshot": "bun pipeline/src/snapshot.ts",
    "reference": "bun pipeline/src/reference.ts",
    "report": "bun pipeline/src/report.ts",
    "db:psql": "docker compose -f db/compose.yaml exec db psql -U ripstaurant"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.0.0",
    "@types/bun": "latest",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-import-resolver-typescript": "^4.4.0",
    "eslint-plugin-import-x": "^4.16.0",
    "prettier": "^3.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0"
  }
}
